{
  "name": "geocoordinates-rs",
  "version": "0.15.0",
  "description": "Low-level geospatial coordinate primitives (WebAssembly): China datums (GCJ-02/BD-09), datum transforms, DMS/DDM angles, coordinate parsing and formatting, geodesics, local frames (ECEF/ENU/NED/AER), UTM/UPS/MGRS, grid codes (Geohash, Plus Code, Maidenhead, H3, S2), and GeoJSON/WKT/GPX/KML/NMEA ingestion.",
  "license": "MIT OR Apache-2.0",
  "author": "Justin Chung",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/justin13888/geocoordinates-rs.git"
  },
  "homepage": "https://github.com/justin13888/geocoordinates-rs/tree/master/crates/geocoordinates-ffi/web",
  "keywords": [
    "gis",
    "geo",
    "coordinates",
    "gcj02",
    "bd09",
    "wasm",
    "webassembly"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "generate": "ubrn build web --release --no-cargo --no-wasm-pack",
    "build": "bash build.sh",
    "compile": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts",
    "test:packed": "bash test/packed-import.sh",
    "clean": "rm -rf dist src/generated src/index.web.ts rust_modules"
  },
  "dependencies": {
    "@ubjs/core": "0.31.0-3"
  },
  "devDependencies": {
    "tsx": "^4.23.15",
    "typescript": "^5.6.0",
    "uniffi-bindgen-react-native": "0.31.0-3"
  }
}
